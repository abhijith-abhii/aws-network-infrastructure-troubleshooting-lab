#!/bin/bash
set -Eeuo pipefail
exec > >(tee -a /var/log/lab-bootstrap.log) 2>&1
trap 'echo "Lab bootstrap FAILED at line $LINENO"' ERR
# Only the AL2023 S3-hosted repository is allowed. No pip, GitHub or external repo.
for attempt in 1 2 3 4 5; do
  if timeout 180 dnf --disablerepo='*' --enablerepo=amazonlinux \
    --setopt=ip_resolve=4 --setopt=timeout=20 --setopt=retries=2 \
    install -y curl-minimal bind-utils iproute python3 awscli-2; then
    break
  fi
  if [ "$attempt" -eq 5 ]; then exit 1; fi
  sleep 15
done
systemctl enable --now amazon-ssm-agent
for tool in curl dig ip ss python3 aws; do command -v "$tool"; done
# A modern agent is required for the two-endpoint design.
agent_version=$(amazon-ssm-agent -version | awk '{print $NF}')
python3 - "$agent_version" <<'PYCODE'
import sys
v=tuple(int(x) for x in sys.argv[1].split('.'))
assert v >= (3,3,40,0), 'Pin a newer standard AL2023 AMI (SSM >= 3.3.40.0)'
PYCODE
%{ if is_server ~}
install -d -m 0755 /opt/netlab/www
printf 'AWS network lab: HTTP healthy\n' > /opt/netlab/www/index.html
cat > /etc/systemd/system/netlab-http.service <<'UNIT'
[Unit]
Description=Personal AWS networking lab HTTP service
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/opt/netlab/www
ExecStart=/usr/bin/python3 -m http.server 80 --bind 0.0.0.0 --directory /opt/netlab/www
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now netlab-http
for attempt in 1 2 3 4 5 6; do
  if curl --noproxy '*' -fsS --connect-timeout 2 --max-time 4 http://127.0.0.1/; then break; fi
  if [ "$attempt" -eq 6 ]; then exit 1; fi
  sleep 5
done
%{ endif ~}
touch /var/lib/lab-ready
printf 'Lab bootstrap ready\n'
